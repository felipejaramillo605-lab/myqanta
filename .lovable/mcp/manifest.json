{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ouifmvxyqvkjhaivbnux.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "qanta-mcp",
      "version": "0.1.0",
      "title": "Qanta ERP MCP"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List open tasks for the signed-in user's active organization.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status",
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "archived"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Max rows to return",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new task in the signed-in user's active organization.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Task title"
            },
            "description": {
              "description": "Optional details",
              "type": "string"
            },
            "priority": {
              "default": "medium",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "due_date": {
              "description": "Due date ISO YYYY-MM-DD",
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "finance_summary",
        "title": "Finance summary",
        "description": "Return current-month EBITDA breakdown by bucket for the active organization.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "description": "Month start ISO YYYY-MM-01. Defaults to current month.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "low_stock_products",
        "title": "Low stock products",
        "description": "List inventory products at or below their minimum stock level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "upcoming_events",
        "title": "Upcoming agenda events",
        "description": "List upcoming agenda events for the active organization.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
